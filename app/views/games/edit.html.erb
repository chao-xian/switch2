<h1>Edit <%= @game.name %></h1>

<%= form_with model: @game do |form| %>
  <% if @game.errors.any? %>
    <div>
      <h2><%= pluralize(@game.errors.count, "error") %> prohibited this game from being saved:</h2>
      <ul>
        <% @game.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :link %>
    <%= form.text_field :link %>
  </div>

  <div>
    <%= form.label :platform %>
    <%= form.text_field :platform %>
  </div>

  <div>
    <%= form.label :format %>
    <%= form.text_field :format %>
  </div>

  <div>
    <%= form.label :rating %>
    <%= form.number_field :rating, in: 1..5 %>
  </div>

  <div>
    <%= form.label :compatible %>
    <%= form.check_box :compatible %>
  </div>

  <div>
    <%= form.submit "Save" %>
  </div>
<% end %>

<%= link_to "Back to game", @game %>
